# Copy to .env for local development. Never commit real secrets.
MEDGUARDX_ENVIRONMENT=development

# Auth + crypto. In production these are REQUIRED (the service refuses to start
# without them). Generate:
#   JWT secret : python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Fernet key : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDGUARDX_JWT_SECRET=
MEDGUARDX_FERNET_KEY=

# Storage. SQLite for local; a postgresql+psycopg:// URL for production.
MEDGUARDX_DATABASE_URL=sqlite:///./medguardx.db

# NLP model: en_core_web_sm | en_core_web_md | en_core_web_lg | en_core_web_trf
MEDGUARDX_MODEL=en_core_web_md

# Comma-separated CORS allowlist. No "*" in production.
MEDGUARDX_CORS_ORIGINS=http://localhost:3000
